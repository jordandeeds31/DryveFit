generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String          @id @default(uuid())
  email                     String          @unique
  password                  String
  username                  String?         @unique
  city                      String?
  gender                    String?
  isLeaderboardVisible      Boolean         @default(true)
  profileImage              Bytes?
  profileImageMimeType      String?
  passwordResetCodeHash     String?
  passwordResetExpiresAt    DateTime?
  expoPushToken             String?
  // IANA name (e.g. "America/New_York") — the reminder job runs on a
  // fixed interval but needs to know each user's actual local clock to
  // fire at 8:30pm *for them*, not 8:30pm server time.
  timezone                  String?
  lastWorkoutReminderSentAt DateTime?
  // Nutrition-goal inputs (Mifflin-St Jeor) — kept alongside the resolved
  // goals below so the calculator can be re-run if the user updates them,
  // without losing whatever manual override they've made to the goals
  // themselves in the meantime.
  weightLbs                 Float?
  heightInches              Float?
  birthdate                 DateTime?
  activityLevel             String?
  nutritionGoalType         String?
  dailyCalorieGoal          Int?
  dailyProteinGoalG         Int?
  dailyCarbGoalG            Int?
  dailyFatGoalG             Int?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  programs                  Program[]
  workoutLogs               WorkoutLog[]
  cardioSessions            CardioSession[]
  chatMessages              ChatMessage[]
  conversations             Conversation[]
  foodLogEntries            FoodLogEntry[]
  trainer                   Trainer?
  posts                     Post[]
  postLikes                 PostLike[]
  postComments              PostComment[]
  commentLikes              CommentLike[]

  @@index([city])
  @@map("users")
}

model Post {
  id            String        @id @default(uuid())
  userId        String
  // Both optional, but the service layer requires at least one — a post
  // can be a caption-only text post, an image-only post, or both.
  caption       String?
  // Cloudinary-hosted URL (image OR video) — unlike profileImage/exercise
  // GIFs, post media is NOT stored as DB bytes behind an authenticated
  // proxy. Cloudinary serves it directly over its own CDN, which means
  // this URL is publicly viewable by anyone who has it (no login
  // required), not just other signed-in users of this app.
  mediaUrl      String?
  // "image" | "video" — which Cloudinary resource_type it was uploaded
  // as, so the client knows whether to render an <Image> or a player.
  mediaType     String?
  // Cloudinary's asset identifier — kept alongside the URL so the asset
  // can actually be removed from Cloudinary storage on delete, not just
  // unlinked from this row (leaving it billed/counted against quota
  // forever).
  mediaPublicId String?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         PostLike[]
  comments      PostComment[]

  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One like per user per post — liking twice is a toggle-back-off in the
  // UI, not a second row.
  @@unique([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  content   String
  // Null for a top-level comment on the post; set for a reply to another
  // comment. Self-referential with no depth limit — replies can reply to
  // replies indefinitely (see getComments in posts.service.ts, which
  // fetches the flat list and builds the tree in application code rather
  // than recursive queries).
  parentId  String?
  createdAt DateTime      @default(now())
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  likes     CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@map("post_comments")
}

model CommentLike {
  id        String      @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime    @default(now())
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model FoodLogEntry {
  id          String   @id @default(uuid())
  userId      String
  // Calendar day this entry belongs to, stored as local midnight —
  // matches the ProgramDay/WorkoutLog.loggedAt convention elsewhere in
  // this schema, not a real timezone-aware timestamp.
  date        DateTime
  mealType    String
  foodName    String
  brandName   String?
  servingQty  Float
  servingUnit String
  // A snapshot of the nutrition values at logging time (like
  // ExerciseLog snapshotting exerciseName/muscleGroup) — not a live
  // reference back to Nutritionix, since serving size is user-adjustable
  // and a food's listed nutrition can change over time.
  calories    Int
  proteinG    Float
  carbsG      Float
  fatG        Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("food_log_entries")
}

model Program {
  id                  String        @id @default(uuid())
  userId              String
  name                String
  description         String?
  startDate           DateTime
  endDate             DateTime
  durationDays        Int
  daysPerWeek         Int
  fitnessLevel        String        @default("beginner")
  preferredDays       String[]
  trainingSplit       String        @default("full body")
  sessionMinutes      Int
  equipmentAccess     String        @default("full gym")
  trainingGoal        String        @default("general fitness")
  generationStatus    String        @default("pending")
  generationStep      String?
  generationStepIndex Int?
  generationMessage   String?
  generationError     String?
  totalSessions       Int           @default(0)
  generatedSessions   Int           @default(0)
  generatedAt         DateTime?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  weeks               ProgramWeek[]
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate, endDate])
  @@map("programs")
}

model ProgramWeek {
  id         String       @id @default(uuid())
  programId  String
  weekNumber Int
  days       ProgramDay[]
  program    Program      @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_weeks")
}

model ProgramDay {
  id        String            @id @default(uuid())
  weekId    String
  dayNumber Int
  dayName   String
  date      DateTime
  focus     String
  isRestDay Boolean
  week      ProgramWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]

  @@map("program_days")
}

model ProgramExercise {
  id                   String        @id @default(uuid())
  dayId                String
  exerciseName         String
  muscleGroup          String
  sets                 Int
  reps                 Int
  restSeconds          Int
  notes                String?
  order                Int
  isCompleted          Boolean       @default(false)
  recommendedWeight    Float?
  // Snapshot of exerciseName/muscleGroup taken the first time this row is
  // swapped, so it can be reverted back to what was originally prescribed
  // even after multiple swaps. Null means this exercise has never been swapped.
  originalExerciseName String?
  originalMuscleGroup  String?
  day                  ProgramDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseLogs         ExerciseLog[]

  @@map("program_exercises")
}

model WorkoutLog {
  id        String        @id @default(uuid())
  userId    String
  loggedAt  DateTime
  notes     String?
  createdAt DateTime      @default(now())
  exercises ExerciseLog[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_logs")
}

model ExerciseLog {
  id                String           @id @default(uuid())
  workoutLogId      String
  programExerciseId String?          @unique
  exerciseName      String
  muscleGroup       String?
  createdAt         DateTime         @default(now())
  workoutLog        WorkoutLog       @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  programExercise   ProgramExercise? @relation(fields: [programExerciseId], references: [id], onDelete: SetNull)
  sets              ExerciseSet[]

  @@index([exerciseName])
  @@map("exercise_logs")
}

model ExerciseSet {
  id            String      @id @default(uuid())
  exerciseLogId String
  setNumber     Int
  weight        Float?
  reps          Int?
  durationSecs  Int?
  notes         String?
  createdAt     DateTime    @default(now())
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@map("exercise_sets")
}

model CardioSession {
  id              String   @id @default(uuid())
  userId          String
  activityType    String // "walk" | "run" | "bike"
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  distanceMeters  Float
  caloriesBurned  Int?
  avgHeartRate    Int?
  maxHeartRate    Int?
  stepCount       Int?
  // Array<{ lat: number; lng: number; timestamp: number }> — the recorded
  // GPS route, omitted from list queries and only fetched for the detail/
  // map view since it can get large for a long run.
  route           Json
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("cardio_sessions")
}

model Conversation {
  id        String        @id @default(uuid())
  userId    String
  // Derived from the first user message when the conversation is created
  // (like ChatGPT/Claude) — never re-derived afterward, so later messages
  // don't cause the title to drift.
  title     String
  createdAt DateTime      @default(now())
  // Bumped on every new message so the history list can order by most
  // recently active rather than most recently created.
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  // "user" | "assistant" — only the final visible turns are persisted.
  // Any tool calls/results the model makes mid-turn to fetch workout data
  // are resolved within that single request and never stored, so replaying
  // history back to OpenAI on the next message never has to reconstruct
  // OpenAI's stricter tool-call/tool-result message pairing.
  role           String
  content        String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model Exercise {
  id          String   @id @default(uuid())
  name        String   @unique
  muscleGroup String
  equipment   String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  isCompound  Boolean  @default(false)

  @@map("exercises")
}

model Trainer {
  id                 String   @id @default(uuid())
  userId             String   @unique
  bio                String?
  specialties        String[]
  yearsExperience    Int?
  certifications     String[]
  hourlyRate         Float?
  profileImageUrl    String?
  city               String
  state              String
  latitude           Float
  longitude          Float
  isAcceptingClients Boolean  @default(true)
  isVerified         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@map("trainers")
}

model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist_signups")
}
